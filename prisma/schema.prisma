datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  password      String
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())        
  updatedAt     DateTime        @updatedAt
  transactions  Transaction[]
  categories    Category[]

  @@map("users")
}

model Category {
  id            String          @id @default(uuid())
  name          String          // Ex: "Educação", "Contas Fixas", "Investimentos"
  color         String?         // Para salvar as cores da planilha (ex: "azul", "amarelo")
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  // --- SUBCATEGORIAS --
  parentId      String?         // Se for null, é uma categoria Pai. Se tiver um ID, é Filha
  parent        Category?       @relation("SubCategories", fields: [parentId], references: [id])
  SubCategories Category[]      @relation("SubCategories")
  
  createdAt     DateTime        @default(now())

  @@unique([name, userId])
  @@map("categories")
}

model Transaction {
  id                String            @id @default(uuid())
  description       String            // Ex: "escola joão", "nutri gourmet"
  amount            Decimal           @db.Decimal(10, 2)  // Valor do lançamento
  date              DateTime          // Data da transação
  status            TransactionStatus @default(PENDING) //PAID ou PENDING
  type              TransactionType
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          Category?         @relation(fields: [categoryId], references: [id])

  isRecurring       Boolean           @default(false)
  recurrenceGroupId String?           // Opcional, guarda o ID do grupo para vincular os meses

  createdAt         DateTime              @default(now())        
  updatedAt         DateTime              @updatedAt

  @@map("transactions")

  @@index([userId])
}

enum TransactionStatus {
  PAID
  PENDING
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Role {
  USER
  ADMIN
}
